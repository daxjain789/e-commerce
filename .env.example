# ---------------------------------------------------------------------------
# Meridian Commerce — environment configuration
# Copy to .env.local (development) or set these in your host's dashboard.
# ---------------------------------------------------------------------------

# SQLite database file. Directory is created automatically.
DATABASE_PATH=./data/store.db

# Public base URL, used for Stripe redirects and absolute links.
# Leave empty to infer from the incoming request.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial admin account, created on first boot only.
# CHANGE THESE BEFORE DEPLOYING. Password is hashed with scrypt.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Store Owner

# Demo catalogue: seed example products, pages and images on first boot.
# Set to false for a clean store.
SEED_DEMO_DATA=true
